# HTTP port the API listens on
PORT=3001

# PostgreSQL connection. DATABASE_URL takes precedence over the individual DB_* values.
# DATABASE_URL=postgres://phonebook:phonebook@localhost:5432/phonebook
DB_HOST=localhost
DB_PORT=5432
DB_USER=phonebook
DB_PASSWORD=phonebook
DB_NAME=phonebook
# Set to "true" when the database requires TLS (e.g. some managed providers)
DB_SSL=false

# Comma-separated list of origins allowed to call the API directly (CORS)
CORS_ORIGIN=http://localhost:3000

# Insert a handful of sample contacts when the table is empty
SEED_DATA=true
